{
  "name": "crmapp",
  "version": "0.0.0",
  "private": true,
  "description": "CRM conversacional omnicanal multi-inquilino",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "arch:check": "bash scripts/check-architecture.sh",
    "build": "turbo run build",
    "db:dev-roles": "tsx --tsconfig packages/db/tsconfig.json --env-file=.env packages/db/src/cli.ts dev-roles",
    "db:migrate": "tsx --tsconfig packages/db/tsconfig.json --env-file=.env packages/db/src/cli.ts migrate",
    "db:rollback": "tsx --tsconfig packages/db/tsconfig.json --env-file=.env packages/db/src/cli.ts rollback",
    "demo:semilla": "tsx --tsconfig apps/api/tsconfig.json --env-file=.env apps/api/scripts/semilla-demo.mts",
    "dev": "turbo run dev",
    "dev:api": "tsx watch --clear-screen=false --tsconfig apps/api/tsconfig.json --env-file=.env apps/api/src/main.ts",
    "dev:web": "pnpm --filter @crmapp/web dev",
    "dev:worker": "tsx watch --clear-screen=false --tsconfig apps/worker/tsconfig.json --env-file=.env apps/worker/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.dev.yml down -v",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "lint": "turbo run lint",
    "suscripcion:pago": "tsx --tsconfig apps/api/tsconfig.json --env-file=.env apps/api/scripts/registrar-pago.mts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "wa:conectar": "tsx --tsconfig apps/api/tsconfig.json --env-file=.env scripts/conectar-whatsapp.mts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.20.6"
  }
}
