# =============================================================================
# Plantilla de variables de entorno. Solo nombres, nunca valores.
# Copiar a .env y rellenar. .env está en .gitignore y debe seguir estándolo.
# =============================================================================

# --- Entorno ---
NODE_ENV=
LOG_LEVEL=
API_PORT=
API_PUBLIC_URL=
WEB_PUBLIC_URL=

# --- PostgreSQL ---
# DATABASE_URL usa el rol de aplicación, que NO es owner de las tablas:
# RLS con FORCE se salta al owner. Ver ADR-004 (pendiente).
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=

# --- Redis (caché, colas BullMQ, presencia) ---
REDIS_URL=

# --- Almacenamiento S3 (R2 en producción, MinIO en desarrollo) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Cifrado de secretos de inquilino (envelope encryption) ---
# Clave maestra que envuelve las DEK. Rotable; la versión se guarda por fila.
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_VERSION=

# --- Sesiones y autenticación ---
JWT_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
COOKIE_DOMAIN=

# --- WhatsApp Cloud API ---
# Depende de P-01 (Tech Provider propio vs BSP vs WABA compartida).
# Estas son las de la app, no las del inquilino: los tokens por cliente
# viven cifrados en channel_secrets, jamás en variables de entorno.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# --- Instagram / Messenger ---
# Comparte app de Meta; se separa por si acaba en una app distinta.
IG_WEBHOOK_VERIFY_TOKEN=

# --- TikTok Business Messaging ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# --- Pagos (P-10 sin resolver: Stripe es referencia, no decisión) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- IA (P-11: BYOK vs consumo del plan) ---
# Clave de la plataforma. Las claves BYOK de cada cliente van cifradas en base.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_CENTS_DEFAULT=

# --- Correo (invitaciones, avisos de plan) ---
SMTP_URL=
MAIL_FROM=

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
